# ── Perfluence (обязательно) ─────────────────────────────────────────────

# Ключ ВИДЖЕТА: полный URL widget-json (промокоды на витрине).
# НУЖЕН И НА BUILD-МАШИНЕ, И НА RUNTIME: без него build пройдёт,
# но /store/* и /category/* не сгенерируются (см. build:check).
# Взять в dash.perfluence.net (код виджета, data.widget_id в JWT).
PERFLUENCE_WIDGET_URL=

# Ключ АКАУНТА: полный URL results (история заказов для /stats и доказательств).
# Только RUNTIME — на build-машину можно не класть.
PERFLUENCE_RESULTS_URL=

# Пароль приватного дашборда /stats (middleware). Только runtime, ОБЯЗАТЕЛЬНО смени.
STATS_PASSWORD=changeme

# ── Telegram Автопостинг ──────────────────────────────────────────────────
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# ID или юзернейм канала (например @smart_zakupka)
TELEGRAM_CHANNEL_ID=@smart_zakupka
# Секретный ключ для защиты API эндпоинта /api/telegram/post (опционально для cron)
TELEGRAM_POSTING_SECRET=

# ── Опционально ───────────────────────────────────────────────────────────

# Свой домен (по умолчанию подхватится Vercel-URL или promofact.ru)
# NEXT_PUBLIC_SITE_URL=https://promofact.ru